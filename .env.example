APP_ENV=development
DATABASE_URL=sqlite:///./cv_screening.db
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
MAX_ZIP_SIZE_MB=200
MAX_FILE_SIZE_MB=20
MAX_FILES_PER_ZIP=500
ANALYSIS_WORKER_MAX_WORKERS=2
STATUS_STREAM_INTERVAL_SECONDS=1.0

LLM_BACKEND=mock
LLM_PROVIDER=mock
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-10-21

DOCUMENT_INTELLIGENCE_PROVIDER=local
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
AZURE_DOCUMENT_INTELLIGENCE_MODEL_ID=prebuilt-layout

ENABLE_OCR=true
